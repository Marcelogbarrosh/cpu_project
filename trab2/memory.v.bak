module ram
(
	input addr[3:0],
	input data[15:0],
	input we,
	input clk,
	input [2:0] op,
	output [15:0] q
);

	parameter LOAD = 0, CLEAR = 6;
	reg [15:0] ram [15:0];
	reg [3:0] addr_reg;
	
	always@(posedge clk) begin
		case(op)
			LOAD: begin
				if(we) ram[addr] <= data;
				addr_reg <= addr;
			end
			CLEAR: begin
				ram[0] <= 0;
				ram[1] <= 0;
				ram[2] <= 0;
				ram[3] <= 0;
				ram[4] <= 0;
				ram[5] <= 0;
				ram[6] <= 0;
				ram[7] <= 0;
				ram[8] <= 0;
				ram[9] <= 0;
				ram[10] <= 0;
				ram[11] <= 0;
				ram[12] <= 0;
				ram[13] <= 0;
				ram[14] <= 0;
				ram[15] <= 0;
			end
				
		endcase
	end
	
	assign q = ram[addr_reg];

endmodule